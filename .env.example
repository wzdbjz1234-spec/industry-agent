# Investigation Agent: offline deterministic is the safe local default.
QUALITY_LLM_PROVIDER=deterministic

# To enable DeepSeek V4 Flash, set QUALITY_LLM_PROVIDER=deepseek and add this
# value only to your local .env or deployment secret store.
# DEEPSEEK_API_KEY=
QUALITY_LLM_BASE_URL=https://api.deepseek.com
QUALITY_LLM_MODEL=deepseek-v4-flash
QUALITY_LLM_TIMEOUT_S=30

# Runtime resources. Use QUALITY_RUNTIME_MODE=production only with a real
# PostgreSQL/Redis/MinIO deployment; demo remains in-memory for local UI work.
QUALITY_RUNTIME_MODE=demo
QUALITY_DATABASE_URL=postgresql+psycopg://quality:quality-local-only@localhost:5432/quality_case
QUALITY_REDIS_URL=redis://localhost:6379/0
QUALITY_MINIO_ENDPOINT=localhost:9000
QUALITY_MINIO_BUCKET=quality-case
# QUALITY_PROMETHEUS_ENABLED=true

# Phase 21 QMS/identity controls. SHADOW never calls an external write endpoint.
QUALITY_QMS_MODE=SHADOW
# QUALITY_QMS_BASE_URL=https://qms-sandbox.example.com
# QUALITY_OIDC_USERINFO_URL=https://identity.example.com/userinfo

# Optional EfficientAD local runtime settings.
# QUALITY_VISION_EFFICIENTAD_MODEL_DIR=
# QUALITY_VISION_EFFICIENTAD_ROI=1418,564,173,196
# QUALITY_VISION_EFFICIENTAD_THRESHOLD=0.2
# QUALITY_VISION_EFFICIENTAD_DEVICE=cpu
