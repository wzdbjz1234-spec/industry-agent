# Investigation Agent: offline deterministic is the safe local default.
QUALITY_LLM_PROVIDER=deterministic

# To enable DeepSeek V4 Flash, set QUALITY_LLM_PROVIDER=deepseek and add this
# value only to your local .env or deployment secret store.
# DEEPSEEK_API_KEY=
QUALITY_LLM_BASE_URL=https://api.deepseek.com
QUALITY_LLM_MODEL=deepseek-v4-flash
QUALITY_LLM_TIMEOUT_S=30

# Optional EfficientAD local runtime settings.
# QUALITY_VISION_EFFICIENTAD_MODEL_DIR=
# QUALITY_VISION_EFFICIENTAD_ROI=1418,564,173,196
# QUALITY_VISION_EFFICIENTAD_THRESHOLD=0.2
# QUALITY_VISION_EFFICIENTAD_DEVICE=cpu
