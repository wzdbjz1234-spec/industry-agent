{
  "additionalProperties": false,
  "description": "State and result of a frame submitted to the continuous worker.",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "frame_id": {
      "title": "Frame Id",
      "type": "string"
    },
    "scheme": {
      "title": "Scheme",
      "type": "string"
    },
    "status": {
      "enum": [
        "QUEUED",
        "PROCESSING",
        "COMPLETED",
        "FAILED"
      ],
      "title": "Status",
      "type": "string"
    },
    "submitted_at": {
      "format": "date-time",
      "title": "Submitted At",
      "type": "string"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "result_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Id"
    },
    "is_ng": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Is Ng"
    },
    "anomaly_score": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Anomaly Score"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    }
  },
  "required": [
    "job_id",
    "frame_id",
    "scheme",
    "status",
    "submitted_at"
  ],
  "title": "VisionJobContract",
  "type": "object"
}
